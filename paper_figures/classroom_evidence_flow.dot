digraph ClassroomEvidenceFlow {
  graph [rankdir=TB, bgcolor="white", pad="0.30", nodesep="0.30", ranksep="0.50", splines=polyline];
  node [shape=box, style="rounded,filled", color="#CFD9E4", penwidth=1.2, fillcolor="white",
        fontname="PingFang SC", fontsize=12.5, fontcolor="#223247", margin="0.17,0.12"];
  edge [color="#71859A", arrowsize=0.70, penwidth=1.3, fontname="PingFang SC", fontsize=9.5, fontcolor="#52677A"];

  video [label="课堂视频\n原视频或浏览器预提取证据", fillcolor="#EAF2FA", color="#7EA5C9"];
  script [label="讲稿／逐字稿（可选）\n有讲稿时替代ASR文本", fillcolor="#EAF2FA", color="#7EA5C9"];
  materials [label="课程大纲／课件（可选）\n补充目标与教学资源信息", fillcolor="#EAF2FA", color="#7EA5C9"];
  { rank=same; video; script; materials; }
  video -> script [style=invis, weight=8];
  script -> materials [style=invis, weight=8];

  transcript [label="音轨与文本\nFFmpeg抽音 · faster-whisper转写／讲稿", fillcolor="#ECF5F1", color="#82B29A"];
  audio [label="声音与时间信息\n响度／基频／停顿 · ASR时间戳", fillcolor="#ECF5F1", color="#82B29A"];
  frames [label="双轨画面抽取\n稀疏关键帧＋密集帧差／投影切换", fillcolor="#ECF5F1", color="#82B29A"];
  courseware [label="课程材料解析\n大纲文本 · 课件页面与视觉标注", fillcolor="#ECF5F1", color="#82B29A"];
  { rank=same; transcript; audio; frames; courseware; }
  transcript -> audio [style=invis, weight=8];
  audio -> frames [style=invis, weight=8];
  frames -> courseware [style=invis, weight=8];

  textfeat [label="文本／时间轴特征\n提问、案例、衔接；有时间戳时计算等待", fillcolor="#F3F0FB", color="#ACA0D3"];
  audiofeat [label="音频特征\n语速、停顿、响度、语调", fillcolor="#F3F0FB", color="#ACA0D3"];
  visionfeat [label="视觉／课件特征\n视线、手势、板书、页面", fillcolor="#F3F0FB", color="#ACA0D3"];
  { rank=same; textfeat; audiofeat; visionfeat; }
  textfeat -> audiofeat [style=invis, weight=8];
  audiofeat -> visionfeat [style=invis, weight=8];

  evidence [label="结构化证据包\n七类、69个客观特征字段（按可用模态提取）\n原始观察与教学判断分离；缺失信息不补零", fillcolor="#F5F0E7", color="#D8B77D"];
  judge [label="逐维教学判断｜LLM-as-Judge\n五个维度 · 25项二级指标\n依据与建议；证据不足标记“未评估”", fillcolor="#FCEFEA", color="#DDA58B"];
  gb [label="综合评分｜线上GB五分类\n客观特征＋五维评分 → 综合分", fillcolor="#FCEFEA", color="#DDA58B"];
  report [label="可追溯评估报告\n五维结果 · 综合分 · 指标证据 · 改进建议", fillcolor="#EAF2FA", color="#7EA5C9"];
  index [label="报告摘要写入本人私有语料\n由教师选择后用于后续教学问答", fillcolor="#EAF2FA", color="#7EA5C9"];

  video -> transcript;
  video -> audio;
  video -> frames;
  script -> transcript [label="可替代转写"];
  transcript -> audio [label="转写时间信息", constraint=false];
  materials -> courseware;
  transcript -> textfeat;
  audio -> audiofeat;
  audio -> textfeat [label="有时间戳时计算等待", constraint=false];
  frames -> visionfeat [label="VLM标注／变化统计"];
  courseware -> visionfeat;
  courseware -> evidence;
  textfeat -> evidence;
  audiofeat -> evidence;
  visionfeat -> evidence;
  evidence -> judge;
  evidence -> gb [label="客观特征", constraint=false];
  judge -> gb [label="五维评分"];
  judge -> report [label="指标依据", constraint=false];
  gb -> report;
  report -> index;
}
